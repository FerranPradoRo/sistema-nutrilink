/* =======================
   Theme: NutriLink
   ======================= */

QWidget {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    background: #f7f9fc;
    color: #111;
}

/* Barra superior */
#TopAccent {
    background: #20b2a6;
}

/* Tarjetas principales */
#Card {
    background: white;
    border-radius: 16px;
    border: 1px solid #e6ebf3;
}

/* Títulos */
#H1 {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
}

#AppLogoText {
    font-size: 28px;
    font-weight: 800;
    color: #111;
    letter-spacing: 0.4px;
}

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #f8fafc;
    border: 1px solid #d8e0ec;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #20b2a6;
    background: #ffffff;
}

/* Botones generales */
QPushButton {
    background: #e5e9f0;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton:hover {
    background: #d9e2ec;
}

/* Variantes */
QPushButton[type="primary"] {
    background: #20b2a6;
    color: white;
}
QPushButton[type="primary"]:hover {
    background: #1d9d93;
}
QPushButton[type="success"] { background: #22c55e; color: white; }
QPushButton[type="warn"]    { background: #f59e0b; color: white; }
QPushButton[type="danger"]  { background: #ef4444; color: white; }

/* Chip Ver/Ocultar contraseñas (externo al QLineEdit) */
QPushButton#EyeChip {
  color: #0f172a;
  background: #eef2f7;
  border: 1px solid #dde3ee;
  border-radius: 8px;
  padding: 4px 10px;
  font-size: 12px;
  font-weight: 700;
}
QPushButton#EyeChip:hover {
  background: #e6f6f4;
  border: 1px solid #20b2a6;
}

/* Links planos */
QPushButton:flat {
    background: transparent;
    color: #20b2a6;
    font-weight: 600;
    text-decoration: underline;
}
QPushButton:flat:hover { color: #1d9d93; }

/* QGroupBox */
QGroupBox {
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    margin-top: 12px;
    background: #ffffff;
    padding: 10px;
}

/* Tabla */
QTableView {
    background: white;
    alternate-background-color: #f9fafb;
    gridline-color: #e5e7eb;
    selection-background-color: #20b2a6;
    selection-color: white;
}
QHeaderView::section {
    background: #e7ecef;
    padding: 6px;
    border: none;
    font-weight: 600;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

/* Ajustes visuales del saludo en el menú */
QLabel {
    /* nada agresivo global; lo puntual ya lo definimos en el .py con setStyleSheet */
}

/* QGroupBox botón-container: relleno extra para que respire como en la maqueta */
QGroupBox {
    padding: 14px;
}