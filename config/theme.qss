/* ====== NutriLink QSS (sin variables) ====== */

/* Fondo */
QWidget {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                              stop:0 #f3f6fb, stop:1 #e8edf5);
  color: #0f172a;
  font-size: 14px;
}

/* Card */
QFrame#Card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
}

/* Títulos */
QLabel#AppLogoText { font-size: 24px; font-weight: 700; }
QLabel#H1 { font-size: 26px; font-weight: 800; }

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit {
  background: #fafafa;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 8px 12px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QTextEdit:focus {
  border: 1px solid #2bb4a8;
  background: #ffffff;
}

/* Botones base */
QPushButton {
  background: #f3f4f6;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 9px 16px;
}
QPushButton:hover { border-color: #cfd8e3; }
QPushButton:disabled { background: #e5e7eb; color: #9ca3af; }

/* Botones tipados */
QPushButton[type="primary"] { background: #2bb4a8; color: white; }
QPushButton[type="danger"]  { background: #ef4444; color: white; }
QPushButton[type="warn"]    { background: #f59e0b; color: #111; }
QPushButton[type="success"] { background: #22c55e; color: white; }

/* ToolBar */
QToolBar { background: transparent; border: none; padding: 4px 6px; }

/* Tabla */
QHeaderView::section {
  background: #f9fafb;
  color: #0f172a;
  padding: 8px;
  border: 1px solid #e5e7eb;
  font-weight: 600;
}
QTableView {
  gridline-color: #e5e7eb;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  selection-background-color: rgba(43,180,168,.20);
  selection-color: #0f172a;
}
QTableView::item { padding: 6px; }
QTableView::item:alternate { background: #f7fafc; }

/* Dialog */
QDialog { background: #ffffff; }

/* Ajustes para logo emoji y separación */
QLabel#LogoEmoji { padding-top: 8px; }
QLabel#AppLogoText { margin-bottom: 6px; }